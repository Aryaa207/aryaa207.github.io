---
import { getCollection } from 'astro:content';
import { path } from '../lib/paths';
import Airfoil from './Airfoil.astro';
import Visual from './project/Visual.astro';
import { Picture } from 'astro:assets';
import { asset } from '../lib/evidence';
import { projectBriefs } from '../lib/project-briefs';
const projects=(await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const selected=projects.filter(p=>projectBriefs[p.id].selected);
const archiveOrder=['flying-wing-glider','interceptor-capstone','cal50-projectile-cfd','kia-k4-cfd','sr-71-geometry'];
const additional=projects.filter(p=>!projectBriefs[p.id].selected).sort((a,b)=>archiveOrder.indexOf(a.id)-archiveOrder.indexOf(b.id));
const skills=[['Guidance & simulation','MATLAB · PN / APN · Monte Carlo','gnc','pn-guidance'],['Computational fluid dynamics','ANSYS Fluent · CFD · Aerodynamics','cfd','mach5-hypersonic-cfd'],['Embedded systems','Python · Raspberry Pi · Arduino · OpenCV','embedded','sard-drone'],['CAD & fabrication','NX Siemens · Onshape · 3D printing','embedded','flying-wing-glider']];
---
<div class="home-intro"><section class="container hero">
<div class="hero-copy"><p class="eyebrow">ARYAA VIJAY · AEROSPACE ENGINEERING</p><h1>Aryaa Vijay.<br/><span>Aerospace Engineering.</span></h1><p class="hero-description" data-positioning>B.S. Aerospace Engineering · Florida Tech<br/>GPA 3.8 / 4.0 · Class of 2027.</p><p class="hero-focus">Guidance & control<span> / </span>CFD<span> / </span>Embedded systems</p><div class="actions"><a class="button primary" href="#work">Selected projects <span aria-hidden="true">↓</span></a><a class="button secondary" href={path('documents/aryaa-vijay-resume.pdf')} download>Résumé PDF <span aria-hidden="true">↓</span></a></div><p class="availability"><span class="status-dot"></span> Available May 2027 · Full-time & internships</p></div>
<a class="hero-feature" href={path('projects/sard-drone/')} aria-label="Explore S.A.R.D., a solo engineering build">
<Picture src={asset('drone-sunset')} formats={['avif','webp']} widths={[600,1000,1400]} sizes="(max-width: 700px) 100vw, 50vw" loading="eager" fetchpriority="high" alt="Aryaa’s actual quadcopter held against the sunset"/>
<span class="hero-feature-top"><span class="status-dot"></span> INDEPENDENT BUILD <span>01 / S.A.R.D.</span></span>
<span class="hero-feature-bottom"><span class="eyebrow">SENSING · VISION · AVIONICS</span><strong>S.A.R.D.<br/>Quadcopter platform.</strong><span class="feature-tags">64 MP vision <i>·</i> Embedded compute <i>·</i> Custom hardware</span><span class="feature-arrow" aria-hidden="true">↗</span></span>
</a>
</section>
<section class="container proof-strip" aria-label="Engineering proof points">
<a href={path('projects/pn-guidance/')} data-proof="gnc"><strong>200<span> trials</span></strong><span>Monte Carlo guidance analysis ↗</span></a>
<a href={path('projects/mach5-hypersonic-cfd/')} data-proof="cfd"><strong>Mach 5</strong><span>Hypersonic flow investigation ↗</span></a>
<a href={path('projects/sard-drone/')} data-proof="embedded"><strong>Solo<span> build</span></strong><span>Hardware & software integration ↗</span></a>
</section></div>
<section class="section container" id="work"><div class="section-heading"><div><p class="eyebrow">SELECTED ENGINEERING WORK</p><h2>Hardware & analysis.</h2></div><p>Contributions, methods,<br/>and documented outcomes.</p></div>
<div class="work-controls"><div class="lens-switch" role="group" aria-label="Filter projects by engineering role">{[['all','All work'],['gnc','GNC'],['cfd','CFD'],['embedded','Embedded']].map(([value,label])=><button data-lens-button={value} aria-pressed={value==='all'}>{label}</button>)}</div><span data-project-count>{projects.length} projects</span></div>
<div class="project-grid">{selected.map(p=><article class:list={["project-card",{"featured-project":p.id==='sard-drone'}]} data-project data-selected="true" data-lenses={p.data.lenses.join(' ')} data-order={p.data.order}><a href={path(`projects/${p.id}/`)}><Visual kind={p.data.visual} slug={p.id}/><div class="project-card-body"><p class="card-meta">{p.data.lenses.map(l=>l.toUpperCase()).join(' / ')}<span>{p.data.period}</span></p><h3>{p.data.shortTitle}</h3><p class="card-ownership">{projectBriefs[p.id].cardRole}</p><p>{projectBriefs[p.id].cardResult}</p><div class="card-bottom"><span>{projectBriefs[p.id].evidence}</span><span class="circle-arrow" aria-hidden="true">↗</span></div></div></a></article>)}</div>
<details class="project-archive" data-archive><summary>Additional projects & reference models <span data-archive-count>{additional.length} entries</span><span aria-hidden="true">+</span></summary><div class="archive-list">{additional.map(p=><article data-project data-selected="false" data-lenses={p.data.lenses.join(' ')}><a href={path(`projects/${p.id}/`)}><div><p class="eyebrow">{projectBriefs[p.id].evidence}</p><h3>{p.data.shortTitle}</h3><p>{projectBriefs[p.id].cardResult}</p></div><span aria-hidden="true">↗</span></a></article>)}</div></details><p class="sr-only" aria-live="polite" data-filter-status></p></section>
<section class="section container experiment-section" id="playground"><div class="experiment-copy"><p class="eyebrow">INTERACTIVE / FLUID MECHANICS</p><h2>Airfoil flow<br/><span>visualization.</span></h2><p>A two-dimensional potential-flow model. Adjust angle of attack to inspect streamlines and the calculated lift coefficient.</p><p class="experiment-hint">Move the angle-of-attack slider →</p></div><Airfoil/></section>
<section class="about-section" id="about"><div class="container about-grid"><div><p class="eyebrow">EDUCATION & EXPERIENCE</p><h2>Aerospace engineering.<br/><span>Florida Tech.</span></h2><p class="about-intro">I’m an aerospace engineering senior at Florida Tech with experience in guidance simulation, computational fluid dynamics, embedded sensing, and mechanical prototyping.</p><div class="education"><span class="education-icon" aria-hidden="true">↗</span><div><strong>Florida Institute of Technology</strong><p>B.S. Aerospace Engineering · May 2027<br/>GPA 3.8 / 4.0 · Melbourne, Florida</p></div></div><a class="text-link" href={path('resume/')}>View résumé ↗</a></div><div class="about-right"><figure class="portrait"><Picture src={asset('portrait')} formats={['avif','webp']} widths={[500,900]} sizes="(max-width: 700px) 100vw, 40vw" alt="Aryaa presenting the camera hardware at Florida Tech" loading="lazy"/><figcaption>Florida Tech · engineering showcase</figcaption></figure><div class="timeline"><p class="eyebrow">PROJECT TIMELINE</p><ol><li><time>NOW</time><h3>Controls / GNC lead</h3><p>Autonomous counter-UAS interceptor<br/>Senior capstone · in progress</p></li><li><time>APRIL 2026</time><h3>3D PN / APN simulation</h3><p>PN / APN simulation and Monte Carlo analysis in MATLAB.</p></li><li><time>JANUARY 2026</time><h3>Mach 5 CFD analysis</h3><p>Mach 5 external aerodynamics in ANSYS Fluent.</p></li><li><time>AUG–DEC 2025</time><h3>S.A.R.D. integration</h3><p>Avionics, vision processing, and a custom camera mount.</p></li><li><time>MAY 2025</time><h3>Glider design & testing</h3><p>Glider project manager, working with a team of four.</p></li></ol></div></div></div></section>
<section class="section container" id="skills"><div class="section-heading"><div><p class="eyebrow">TECHNICAL SKILLS</p><h2>Methods & tools.</h2></div><p>Applied across the<br/>project portfolio.</p></div><div class="skills-grid">{skills.map(([title,tools,l,slug],i)=><a class="skill-card" data-skill-lens={l} href={path(`projects/${slug}/`)}><span class="skill-number">0{i+1} <span>↗</span></span><h3>{title}</h3><p>{tools}</p></a>)}</div><div class="research-note"><p class="eyebrow">RESEARCH EXPERIENCE</p><h3>Functional Biomaterials Lab.</h3><p>As an undergraduate research assistant in Florida Tech’s Functional Biomaterials Lab (September 2025–April 2026), I worked on sample preparation, 3D bioprinting equipment, and laboratory documentation.</p></div></section>
<section class="contact-section" id="contact"><div class="container"><p class="eyebrow">CONTACT & AVAILABILITY</p><h2>Contact Aryaa.</h2><p>Seeking GNC, CFD, and embedded systems opportunities.<br/>Available May 2027 for full-time roles or internships.</p><div class="actions"><a class="button primary" href="mailto:avijay2024@my.fit.edu">Email Aryaa ↗</a><button class="button secondary" data-copy-email>Copy email</button></div><p class="copy-status" aria-live="polite" data-copy-status></p><div class="contact-links"><a href="https://linkedin.com/in/aryaa-vijay">LinkedIn ↗</a><a href="https://github.com/Aryaa207">GitHub ↗</a><a href={path('documents/aryaa-vijay-resume.pdf')} download>Download résumé ↓</a></div></div></section>
<script>
import '../lib/scroll-reveal';
import { lens, parseLens, positioning } from '../lib/lens';
import type { Lens } from '../types';
const feature=document.querySelector<HTMLElement>('.hero-feature');
if(feature&&matchMedia('(hover:hover) and (prefers-reduced-motion:no-preference)').matches){feature.addEventListener('pointermove',event=>{const box=feature.getBoundingClientRect();feature.style.setProperty('--tilt-x',`${(0.5-(event.clientY-box.top)/box.height)*3}deg`);feature.style.setProperty('--tilt-y',`${((event.clientX-box.left)/box.width-0.5)*3}deg`);});feature.addEventListener('pointerleave',()=>{feature.style.setProperty('--tilt-x','0deg');feature.style.setProperty('--tilt-y','0deg');});}
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-lens-button]');
function update(value:Lens){
 buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.lensButton===value)));
 document.documentElement.dataset.lens=value;
 const line=document.querySelector('[data-positioning]');if(line)line.textContent=positioning[value];
 let selectedCount=0,archiveCount=0;document.querySelectorAll<HTMLElement>('[data-project]').forEach(card=>{const relevant=value==='all'||card.dataset.lenses!.split(' ').includes(value);card.hidden=!relevant;if(relevant){if(card.dataset.selected==='true')selectedCount++;else archiveCount++;}});
 document.querySelector('[data-project-count]')!.textContent=`${selectedCount} selected · ${archiveCount} additional`;
 const archive=document.querySelector<HTMLDetailsElement>('[data-archive]')!;archive.hidden=archiveCount===0;archive.open=value!=='all';document.querySelector('[data-archive-count]')!.textContent=`${archiveCount} entries`;
 document.querySelector('[data-filter-status]')!.textContent=`${selectedCount} selected projects and ${archiveCount} additional entries for ${value==='all'?'all disciplines':value.toUpperCase()}. ${value==='all'?'Expand Additional projects to see the archive.':''}`;
 document.querySelectorAll<HTMLElement>('[data-skill-lens]').forEach(el=>el.classList.toggle('highlight',value!=='all'&&el.dataset.skillLens===value));
 document.querySelectorAll<HTMLElement>('[data-proof]').forEach(el=>el.style.order=el.dataset.proof===value?'-1':'0');
}
lens.subscribe(update);
buttons.forEach(b=>b.addEventListener('click',()=>{const value=parseLens(b.dataset.lensButton!);const url=new URL(location.href);if(value==='all')url.searchParams.delete('lens');else url.searchParams.set('lens',value);history.pushState({},'',url);lens.set(value);}));
const sync=()=>lens.set(parseLens(new URLSearchParams(location.search).get('lens')??document.documentElement.dataset.lens??null));
window.addEventListener('popstate',()=>lens.set(parseLens(new URLSearchParams(location.search).get('lens'))));sync();
</script>
