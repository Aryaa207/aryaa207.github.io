---
import { path } from '../../lib/paths';
interface Props {name:string;title:string;description:string}
const {name,title,description}=Astro.props;
---
<figure class="video-evidence" id={name}><video controls playsinline preload="none" poster={path(`videos/${name}.jpg`)} aria-label={title}><source src={path(`videos/${name}.mp4`)} type="video/mp4"/><a href={path(`videos/${name}.mp4`)}>Download {title}</a></video><figcaption><strong>{title}</strong><p>{description} Silent video; visual description provided here.</p></figcaption></figure>
<style>.video-evidence{margin:30px 0}.video-evidence video{display:block;width:100%;max-height:520px;border-radius:16px;background:#080b10;border:1px solid #ffffff20}.video-evidence figcaption{padding-top:14px;font-size:13px}.video-evidence figcaption p{color:var(--muted);font-size:12px;margin-top:7px}</style>
