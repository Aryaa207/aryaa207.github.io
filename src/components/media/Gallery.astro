---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { src: ImageMetadata; alt: string; caption: string }[] }
const items=await Promise.all(Astro.props.items.map(async item=>({...item,full:await getImage({src:item.src,width:Math.min(item.src.width,1800),format:'webp'})})));
---
<media-gallery>
<div class="gallery-grid">{items.map((item,index)=><figure><a href={item.full.src} data-gallery-index={index} data-caption={item.caption} aria-label={`Enlarge image: ${item.alt}`}><Picture src={item.src} formats={['avif','webp']} widths={[500,900]} sizes="(max-width: 700px) 100vw, 70vw" alt={item.alt} loading="lazy"/></a><figcaption>{item.caption}</figcaption></figure>)}</div>
<dialog class="lightbox" aria-label="Project image viewer"><div class="lightbox-toolbar"><button data-close aria-label="Close image viewer">Close ×</button><button data-prev aria-label="Previous image">←</button><button data-next aria-label="Next image">→</button><label>Zoom <input type="range" min="1" max="3" step="0.25" value="1" aria-label="Image zoom"/></label></div><div class="lightbox-stage" tabindex="0" aria-label="Image; drag or scroll to pan"><img alt=""/></div><p data-caption-output aria-live="polite"></p></dialog>
</media-gallery>
<script>
class MediaGallery extends HTMLElement {
 connectedCallback(){
  const links=[...this.querySelectorAll<HTMLAnchorElement>('[data-gallery-index]')],dialog=this.querySelector('dialog')!,image=dialog.querySelector('img')!,stage=this.querySelector<HTMLElement>('.lightbox-stage')!,zoom=this.querySelector<HTMLInputElement>('input')!,caption=this.querySelector('[data-caption-output]')!;let index=0;
  const show=(i:number)=>{index=(i+links.length)%links.length;const link=links[index];image.src=link.href;image.alt=link.querySelector('img')?.alt??'';caption.textContent=link.dataset.caption??'';zoom.value='1';image.style.width='100%';stage.scrollTo(0,0);};
  links.forEach((link,i)=>link.addEventListener('click',e=>{e.preventDefault();show(i);dialog.showModal();}));
  dialog.querySelector('[data-close]')!.addEventListener('click',()=>dialog.close());
  dialog.querySelector<HTMLButtonElement>('[data-prev]')!.disabled=links.length<2;dialog.querySelector<HTMLButtonElement>('[data-next]')!.disabled=links.length<2;
  dialog.querySelector('[data-prev]')!.addEventListener('click',()=>show(index-1));dialog.querySelector('[data-next]')!.addEventListener('click',()=>show(index+1));
  dialog.addEventListener('keydown',e=>{if(e.target instanceof HTMLInputElement)return;if(e.key==='ArrowLeft'){e.preventDefault();show(index-1);}if(e.key==='ArrowRight'){e.preventDefault();show(index+1);}});
  zoom.addEventListener('input',()=>image.style.width=`${Number(zoom.value)*100}%`);
  let drag:{x:number;y:number;left:number;top:number}|null=null;
  stage.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;drag={x:e.clientX,y:e.clientY,left:stage.scrollLeft,top:stage.scrollTop};stage.setPointerCapture(e.pointerId);e.preventDefault();});
  stage.addEventListener('pointermove',e=>{if(drag){stage.scrollLeft=drag.left-(e.clientX-drag.x);stage.scrollTop=drag.top-(e.clientY-drag.y);}});stage.addEventListener('pointerup',()=>drag=null);stage.addEventListener('pointercancel',()=>drag=null);
 }
}
customElements.define('media-gallery',MediaGallery);
</script>
<style>
.gallery-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.gallery-grid figure{margin:15px 0}.gallery-grid figure:first-child{grid-column:1/-1}.gallery-grid a{height:230px}.gallery-grid figure:first-child a{height:auto}.gallery-grid a img{object-fit:contain;height:100%;width:100%}@media(max-width:700px){.gallery-grid{grid-template-columns:1fr;gap:10px}.gallery-grid a{height:auto}}.gallery-grid a{display:block;background:white;border:1px solid #ffffff22;border-radius:16px;overflow:hidden}.gallery-grid img{width:100%;height:auto}.gallery-grid figcaption{font-size:12px;color:#a7b9cc;margin-top:12px}.lightbox{width:min(1100px,94vw);height:90vh;max-width:none;border:0;border-radius:18px;padding:18px;background:#101923;color:#edf5ff}.lightbox::backdrop{background:#06101bdd;backdrop-filter:blur(8px)}.lightbox-toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.lightbox button{min-width:44px;min-height:44px;background:#263d50;color:#e6f2fc;border-radius:8px;padding:10px 16px}.lightbox button:disabled{opacity:.4;cursor:default}.lightbox label{display:flex;align-items:center;gap:10px;font-size:13px}.lightbox input{min-height:44px}.lightbox-stage{overflow:auto;height:calc(100% - 125px);background:white;border-radius:10px;cursor:grab}.lightbox-stage img{max-width:none;width:100%;height:auto;user-select:none}.lightbox p{font-size:12px;color:#a7b9cc;margin-top:12px}
</style>
