---
import { Picture } from 'astro:assets';
import car from '../../assets/kia-cfd.png';
import { covers } from '../../lib/evidence';
interface Props { kind: string; label?: string; slug?: string }
const {kind,label='Conceptual engineering illustration',slug=''}=Astro.props;
const cover=covers[slug];
---
<div class:list={['project-visual',`visual-${kind}`]}>
{cover?<Picture src={cover.src} formats={['avif','webp']} widths={[480,900,1400]} sizes="(max-width: 700px) 100vw, 55vw" alt={cover.alt} loading="lazy"/>:kind==='car'?<Picture src={car} formats={['avif','webp']} widths={[400,800,1200]} sizes="(max-width: 700px) 100vw, 50vw" alt="Recovered Kia K4 surface geometry rendering" loading="lazy"/>:kind==='drone'?<svg viewBox="0 0 600 360" role="img" aria-label="Conceptual quadcopter subsystem diagram">
<defs><radialGradient id="drone-bg"><stop stop-color="#243e59"/><stop offset="1" stop-color="#101a28"/></radialGradient></defs><rect width="600" height="360" fill="url(#drone-bg)"/>
<g fill="none" stroke="#6c92b3" stroke-width="1"><ellipse cx="300" cy="215" rx="210" ry="93" stroke-dasharray="3 8"/><path d="M95 215H505M300 100V310" opacity=".4"/></g>
<g stroke="#91a9bf" stroke-width="14" stroke-linecap="round"><path d="M195 110L405 270M405 110L195 270"/></g>
<g fill="#233b53" stroke="#aec7df"><path d="M253 155L300 132L349 155V219L300 244L253 219Z"/><path d="M270 169L300 153L333 169V207L300 222L270 207Z" fill="#365771"/></g>
<g fill="#92a9bd" stroke="#c8e3f9">{[[195,110],[405,110],[195,270],[405,270]].map(([x,y])=><g><ellipse cx={x} cy={y} rx="59" ry="17" fill="none" opacity=".5"/><ellipse cx={x} cy={y} rx="50" ry="6" transform={`rotate(-16 ${x} ${y})`}/><circle cx={x} cy={y} r="9" fill="#203b52"/></g>)}</g>
<g fill="#aec8de" font-size="11" font-family="monospace"><text x="33" y="38">FLIGHT CONTROL / SENSING / VISION</text><text x="33" y="333">SYSTEM ARCHITECTURE · CONCEPTUAL</text></g></svg>:<svg viewBox="0 0 600 360" role="img" aria-label={label}>
<defs><radialGradient id={`bg-${kind}`}><stop stop-color="#183753"/><stop offset="1" stop-color="#0c1725"/></radialGradient></defs><rect width="600" height="360" fill={`url(#bg-${kind})`}/>
<g stroke="#486482" opacity=".3" stroke-width=".6">{Array.from({length:12},(_,i)=><path d={`M${i*55} 0V360M0 ${i*36}H600`}/>)}</g>
{kind==='guidance'||kind==='capstone'?<g fill="none"><g stroke="#718aa0" opacity=".5"><ellipse cx="305" cy="184" rx="145" ry="116" transform="rotate(-18 305 184)"/><ellipse cx="305" cy="184" rx="208" ry="70" transform="rotate(-35 305 184)"/></g><path d="M70 277C204 284 198 118 302 173S426 115 524 87" stroke="#86c7ff" stroke-width="3"/><path d="M91 97C206 80 241 243 354 190S470 124 524 87" stroke="#e4efff" stroke-width="1.5" stroke-dasharray="5 7"/><circle cx="524" cy="87" r="5" fill="#eff7ff"/><circle cx="524" cy="87" r="19" stroke="#a3d3fc"/><g fill="#a4b9cf" font-size="11" font-family="monospace"><text x="30" y="35">{kind==='capstone'?'SYSTEMS / CONTROLS':'MODELING / ANALYSIS'}</text><text x="30" y="330">CONCEPTUAL VISUALIZATION · NOT SIMULATION DATA</text></g></g>:<g fill="none">{Array.from({length:24},(_,i)=><path d={`M-10 ${i*17-15} Q210 ${i*17-15} 290 ${180+(i-12)*8} T620 ${i*17-15}`} stroke={i%4===0?'#9ecef5':'#467190'} stroke-width={i%4===0?1.3:.65}/>)}<path d="M174 191Q192 147 265 155L443 188Q270 192 174 191" fill="#ccdfef" stroke="#e6f2fd"/><g fill="#a4b9cf" font-size="11" font-family="monospace"><text x="30" y="35">COMPRESSIBLE FLOW / AERODYNAMICS</text><text x="30" y="330">CONCEPTUAL ILLUSTRATION · NOT A CFD RESULT</text></g></g>}
</svg>}
</div>
