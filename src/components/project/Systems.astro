const systems=[
 {name:'Structure',tag:'01 / THE PLATFORM',title:'Airframe & mechanical integration',body:'A 500 mm quadcopter airframe carries the embedded payload. The custom pan–tilt camera mount was designed in Onshape and 3D printed, with vibration-isolation hardware supporting the physical integration.',parts:['500 mm airframe','Custom camera mount','Vibration isolation']},
 {name:'Vision',tag:'02 / THE PAYLOAD',title:'Vision payload',body:'A 64 MP Arducam and a secondary 2 MP camera connect to the onboard vision system. Python and OpenCV process the image stream, while two micro servos provide mechanical pan and tilt.',parts:['64 MP Arducam','2 MP secondary camera','2-axis pan–tilt']},
 {name:'Sensing',tag:'03 / THE INPUTS',title:'Sensor acquisition',body:'The documented sensor stack includes NEO-6M GPS and inertial sensing. The Arduino Nano supports data acquisition, with the Raspberry Pi handling the higher-level software and visualization.',parts:['NEO-6M GPS','Inertial sensing','Arduino Nano']},
 {name:'Compute',tag:'04 / THE SOFTWARE',title:'Onboard software',body:'A Raspberry Pi 4B runs the Python/OpenCV payload software. Bench demonstrations make the interface between cameras, sensors, and software visible before full system integration.',parts:['Raspberry Pi 4B','Python / OpenCV','Bench visualization']},
 {name:'Flight & power',tag:'05 / THE FOUNDATION',title:'Flight control & electrical power',body:'The KK2.1.5 flight controller provides stabilization, while the embedded computers handle the payload. The project poster documents a 3S LiPo power system and identifies controller integration as a future improvement.',parts:['KK2.1.5 controller','3S LiPo','Motor controllers']}
];
---
<section class="systems-explorer" aria-labelledby="systems-heading"><div class="systems-heading"><p class="eyebrow">INTERACTIVE SYSTEM WALKTHROUGH</p><h2 id="systems-heading">Subsystem architecture.</h2><p>Explore the architecture behind S.A.R.D.</p></div><div class="systems-content"><div class="systems-tabs" role="tablist" aria-label="S.A.R.D. subsystems">{systems.map((s,i)=><button id={`system-tab-${i}`} role="tab" aria-controls={`system-panel-${i}`} aria-selected={i===0} tabindex={i===0?0:-1} data-system={i}>{s.name}</button>)}</div>{systems.map((s,i)=><div class="system-panel" id={`system-panel-${i}`} role="tabpanel" aria-labelledby={`system-tab-${i}`} hidden={i!==0} tabindex="0"><span class="system-index" aria-hidden="true">0{i+1}</span><p class="eyebrow">{s.tag}</p><h3>{s.title}</h3><p>{s.body}</p><div class="system-parts">{s.parts.map(p=><span>{p}</span>)}</div></div>)}</div></section>
<script>
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-system]')];
const choose=(i:number,focus=false)=>{tabs.forEach((tab,n)=>{tab.setAttribute('aria-selected',String(n===i));tab.tabIndex=n===i?0:-1;document.getElementById(tab.getAttribute('aria-controls')!)!.hidden=n!==i;});if(focus)tabs[i].focus();};
tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>choose(i));tab.addEventListener('keydown',e=>{const offsets:Record<string,number>={ArrowRight:1,ArrowLeft:-1,Home:-i,End:tabs.length-1-i};if(e.key in offsets){e.preventDefault();choose((i+offsets[e.key]+tabs.length)%tabs.length,true);}});});
</script>
