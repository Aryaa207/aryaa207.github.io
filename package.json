{
  "name": "aryaa-vijay-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ingest-raw.ts && astro dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/ingest-raw.ts && node scripts/check-missing.ts && node scripts/social.ts && astro build && node scripts/check-dist.ts",
    "build:preview": "ALLOW_MISSING=1 npm run build",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.ts",
    "inventory": "node scripts/inventory.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.4",
    "katex": "0.18.7",
    "nanostores": "1.5.3",
    "pdfjs-dist": "6.3.289",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "2.1.1",
    "lighthouse": "13.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
